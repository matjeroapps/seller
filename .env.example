APP_ENV=development
HTTP_ADDR=:8080
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://commerce:commerce@localhost:5672/
ZITADEL_ISSUER=http://localhost:8081
SHUTDOWN_TIMEOUT_SECONDS=10

# Core internal API (ADR-017).
#
# Seller owns no database. Every business capability is a Core-owned runtime
# call, so CORE_API_BASE_URL and CORE_API_TOKEN are required for the service to
# start.
#
# CORE_API_BASE_URL is the private service-network address of core-api, e.g.
# "http://core-api:8080". It is never a public URL and is never called by a
# browser.
#
# CORE_API_TOKEN is this service's credential, presented to Core as
# "Authorization: Bearer <token>" together with "X-Matjero-Service: seller".
# It must match CORE_INTERNAL_SELLER_TOKEN on the Core side.
#
# This is a secret. Never commit a real value, never log one, and never bake one
# into an image layer. In production it is injected by the orchestrator's secret
# store. The build environment must never require it.
CORE_API_BASE_URL=http://localhost:8080
CORE_API_TOKEN=

# Per-call timeout for Core requests, in seconds.
CORE_API_TIMEOUT_SECONDS=10

# THEME_PREVIEW_SECRET is no longer read here. Theme preview tokens are signed by
# Core, which owns the theme business logic; seller-api only forwards the request
# and returns the token Core issues. Configure THEME_PREVIEW_SECRET on core-api.
